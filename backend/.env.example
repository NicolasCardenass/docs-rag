# Copy to backend/.env and adjust. Every variable is optional: the defaults
# run the whole app locally with deterministic mock providers (no API keys).

# --- General -----------------------------------------------------------------
DOCS_RAG_ENVIRONMENT=development        # development | production | test
DOCS_RAG_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
DOCS_RAG_DATA_DIR=data                  # where uploads and the vector index live
DOCS_RAG_CORS_ORIGINS=["http://localhost:3000"]

# --- Ingestion and retrieval -------------------------------------------------
DOCS_RAG_MAX_UPLOAD_MB=20
DOCS_RAG_CHUNK_SIZE=800                 # characters per chunk
DOCS_RAG_CHUNK_OVERLAP=120              # characters shared by consecutive chunks
DOCS_RAG_TOP_K=4                        # chunks retrieved per question

# --- Providers -----------------------------------------------------------------
DOCS_RAG_EMBEDDING_PROVIDER=mock        # mock | openai | ollama
DOCS_RAG_LLM_PROVIDER=mock              # mock | openai | anthropic | ollama

# OpenAI (required when a provider above is "openai")
# DOCS_RAG_OPENAI_API_KEY=
# DOCS_RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# DOCS_RAG_OPENAI_CHAT_MODEL=gpt-4o-mini

# Anthropic (required when DOCS_RAG_LLM_PROVIDER=anthropic)
# DOCS_RAG_ANTHROPIC_API_KEY=
# DOCS_RAG_ANTHROPIC_MODEL=claude-haiku-4-5

# Ollama (local models, no key needed)
# DOCS_RAG_OLLAMA_BASE_URL=http://localhost:11434
# DOCS_RAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# DOCS_RAG_OLLAMA_CHAT_MODEL=llama3.2
